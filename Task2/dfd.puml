' ============================================================================
' «Будущее 2.0» — Data Flow Diagram (DFD) потоков данных между доменами
' Нотация: Гейн-Сарсон (упрощённая):
'   прямоугольники — внешние сущности; овалы (usecase) — процессы;
'   цилиндры (database) — накопители данных; стрелки — потоки данных.
' Маркеры [B1..B6] — ключевые бизнес-сценарии (см. domains.md)
' Отрисовать: plantuml -tpng dfd.puml
' ============================================================================
@startuml feature2_0
title Data Flow Diagram — «Будущее 2.0», потоки данных между доменами\n(поддержка бизнес-сценариев B1–B6)

skinparam defaultTextAlignment center
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 40
skinparam usecaseBackgroundColor #FFF9C4
skinparam databaseBackgroundColor #B2DFDB
skinparam rectangleBackgroundColor #FFFFFF
skinparam ArrowThickness 1.5

' ============================ ЛЕГЕНДА ============================
package "Легенда нотации DFD" as Legend {
  rectangle "Внешняя сущность\n(человек / система\nвне границ)" as LegExt #FFFFFF
  usecase "Процесс\n(преобразование\nданных)" as LegProc
  database "Накопитель\nданных\n(D1..D9)" as LegStore
}
LegExt -[hidden]right- LegProc
LegProc -[hidden]right- LegStore

' ============================ ВНЕШНИЕ СУЩНОСТИ ============================
rectangle "Пациент\nклиники" as Patient
rectangle "Врач /\nоператор клиники" as Doctor
rectangle "Клиент банка" as BankClient
rectangle "Бизнес-пользователь\n(аналитик домена / головного офиса)" as BizUser
rectangle "Партнёр:\nфармацевтика /\nэлектроника" as Partner
rectangle "Руководство\nкомпании" as Mgmt

' ============================ D-MED: МЕДИЦИНСКИЙ ДОМЕН ============================
package "D-MED — Медицинский домен (клиники)" as MedDomain {
  usecase "P1.1\nЗапись на приём\nи расписание" as P11
  usecase "P1.2\nВедение ЭМК\n(диагнозы, назначения)" as P12
  usecase "P1.3\nПроведение\nдиагностических\nисследований" as P13
  usecase "P1.4\nОбезличивание\nмед. данных\n(только для ИИ-домена)" as P14
  database "D1: ЭМК / МИС\n(карты, истории болезни,\nрезультаты исследований)" as D1
  database "D2: Расписание\nи записи" as D2
  database "D3: Обезличенные\nвыборки для ИИ-домена\n(в аналитику не передаются)" as D3

  Doctor --> P11
  Patient --> P11
  P11 --> D2 : запись на приём
  P11 --> P12 : запись в очередь
  Doctor --> P12
  P12 --> D1 : мед. карта,\nистория болезни
  D1 --> P12 : анамнез
  Doctor --> P13
  P13 --> D1 : результаты\nисследований
  D1 --> P13 : назначение

  ' --- ИИ-контур: замкнут внутри медицинского направления [B3] ---
  D1 --> P14 : исходные мед. данные
  P14 --> D3 : обезличенные выборки
}

' ============================ D-AI: ИИ-ДОМЕН ============================
package "D-AI — Домен ИИ-сервисов" as AIDomain {
  usecase "P2.1\nAI-инференс:\nанализ исследований,\nподдержка диагноза" as P21
  usecase "P2.2\nОбучение моделей\n(ML-конвейер)" as P22
  database "D3a: Обучающие\nвыборки,\nверсии моделей" as D3a

  D3 --> P21 : обезличенные данные\nисследования [B3]
  P21 --> D1 : результаты AI-анализа\n→ в мед. карту
  D3 --> P22 : выборки [B3]
  P22 --> D3a : версии моделей,\nметрики качества
  D3a --> P21 : модель
}

' ============================ D-FIN: ФИНТЕХ-ДОМЕН ============================
package "D-FIN — Финтех-домен (банк)" as FinDomain {
  usecase "P3.1\nСчета и платежи\n(в т.ч. оплата\nмед. услуг)" as P31
  usecase "P3.2\nКредитный конвейер\nи скоринг" as P32
  usecase "P3.3\nНовый финтех-сервис\n(запуск в домене,\nбез DWH)" as P33
  database "D4: Банковское ядро\n(счета, платежи,\nфин. история)" as D4
  database "D5: Кредитный\nпортфель" as D5

  BankClient --> P31
  P31 --> D4 : транзакции
  D4 --> P31 : баланс, история
  BankClient --> P32
  P32 --> D4 : скоринг по фин. истории [B4]
  D4 --> P32
  P32 --> D5 : кредитные договоры
  P32 --> P33 : решение по кредиту [B4]
  P33 --> D4 : операции нового сервиса
}

' ============================ D-CORP: КОРПОРАТИВНЫЙ ДОМЕН ============================
package "D-CORP — Корпоративный домен (головной офис)" as CorpDomain {
  usecase "P4.1\nКонсолидация KPI\nпо доменам" as P41
  usecase "P4.2\nУправленческая\nотчётность" as P42
  database "D6: Корпоративное\nхранилище\n(KPI, фин. отчётность,\nHR, инвентаризация)" as D6

  P41 --> D6 : консолидированные KPI
  D6 --> P42 : KPI-срезы
  P42 --> Mgmt : отчёт [B2]
}

' ============================ D-PART: ПАРТНЁРСКИЙ ДОМЕН ============================
package "D-PART — Домен новых партнёров (фарма, электроника)" as PartDomain {
  usecase "P5.1\nОнбординг партнёра\n(типовая платформа\nиз шаблона)" as P51
  usecase "P5.2\nСпросовая аналитика\nи поставки\n(по обезличенным\nсрезам)" as P52
  database "D7: Каталог партнёра,\nдоговоры, заявки" as D7

  Partner --> P51
  P51 --> D7 : каталог,\nдоговоры [B5]
  D7 --> P52
}

' ============================ D-PLAT: ПЛАТФОРМЕННЫЙ СЛОЙ ============================
package "D-PLAT — Платформенный слой (Data Platform Team)" as PlatDomain {
  usecase "P6.1\nВитрина данных:\nкаталог, semantic layer,\nконструктор отчётов" as P61
  usecase "P6.2\nИнтеграционный слой:\nKafka + CDC\n(замена ESB)" as P62
  database "D8: Data-продукты\nдоменов\n(MED / FIN / CORP / PART)" as D8

  BizUser --> P61 : запрос отчёта [B1]
  P61 --> D8 : федеративный запрос\nк data-продуктам [B1]
  D8 --> P61 : срезы по уровню доступа
  P61 --> P41 : консолидированные\nданные для KPI [B2]
}

' ============================ МЕЖДОМЕННЫЕ ПОТОКИ ============================
' Мед -> платформа: только ОПЕРАЦИОННЫЕ события (расписание, записи, посещения).
' Мед. карты / истории болезни / результаты исследований (D1) и их обезличенные
' выборки (D3) в витрину данных НЕ поступают: бизнес исключил их из аналитики,
' контур D1 -> P14 -> D3 -> D-AI замкнут.
D2 --> P62 : операционные события\n(записи, посещения) [B1]
P62 --> D8 : инжест в\nMed data-продукт\n(без мед. карт и исследований)
note right of D3
  Контур мед. данных замкнут:
  D1 -> P14 -> D3 -> D-AI.
  Мед. карты, истории болезни
  и результаты исследований
  в витрину данных не включаются
end note
' Фин -> платформа
D4 --> P62 : фин. события [B1]
P62 --> P33 : события «услуга оказана»\nиз мед. домена [B4]
' Партнёры
P62 --> P52 : обезличенные спросовые\nсрезы по контракту [B5]
D8 --> P52 : data-продукт\nспроса [B5]
' Легаси: миграция
usecase "P7.1\nМиграция исторических\nданных из DWH\n(CDC)" as P71
database "D9: Легаси-DWH\nSQL Server 2008\n(заморожен на запись)" as D9
D9 --> P71 : исторические данные [B6]
P71 --> P62 : в доменные\nплатформы [B6]
P62 --> P61 : доступ к легаси-срезам\n(временно, read-only)
@enduml
